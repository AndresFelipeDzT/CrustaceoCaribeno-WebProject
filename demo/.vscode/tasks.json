{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "maven-clean-compile",
            "type": "process",
            "command": "${workspaceFolder}/mvnw",
            "args": [
                "clean",
                "compile"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "command": "${workspaceFolder}\\mvnw.cmd"
            },
            "problemMatcher": [
                "$maven"
            ]
        }
    ]
}
